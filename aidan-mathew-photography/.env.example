# Copy to .env.local (web app) and set the same values on your hosting provider.
# Never commit real values. Keys marked SERVER ONLY must never be exposed to the browser.

# --- Supabase (Dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY. Needed to receive form submissions and to publish/delete media.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: dedicated storage host for faster large uploads.
# NEXT_PUBLIC_SUPABASE_STORAGE_UPLOAD_URL=https://your-project-ref.storage.supabase.co/storage/v1

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.example.com
# SERVER ONLY. Any long random string; used to hash visitor IPs for rate limiting.
RATE_LIMIT_SALT=replace-with-a-long-random-string

# --- Media limits (shared by browser, server and worker; keep identical everywhere) ---
# Must not exceed the bucket limit in supabase/migrations/20261003000004_storage.sql
# or your Supabase plan's global upload limit (Free plan: 50 MB).
NEXT_PUBLIC_MAX_VIDEO_MB=200
NEXT_PUBLIC_MAX_IMAGE_MB=40
NEXT_PUBLIC_MIN_IMAGE_EDGE_PX=600
NEXT_PUBLIC_MAX_IMAGE_EDGE_PX=12000
# Container timestamps can differ by a few milliseconds from the edit length.
NEXT_PUBLIC_VIDEO_DURATION_TOLERANCE_S=0.05

# ======================================================================
# Worker only (the worker host's environment)
# ======================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY (same as above)
WORKER_ID=worker-1
WORKER_POLL_INTERVAL_MS=3000
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Email: "resend" or "none". With "none", emails stay queued (nothing is lost) until configured.
EMAIL_PROVIDER=none
RESEND_API_KEY=
# Must be an address on a domain verified with the provider.
EMAIL_FROM="Aidan Mathew Photography <hello@example.com>"
SITE_URL=https://www.example.com

ABANDONED_UPLOAD_HOURS=24
# Off by default. When true, declined/cancelled bookings and closed/spam inquiries older
# than RETENTION_DAYS are deleted hourly. Confirmed bookings are never auto-deleted.
RETENTION_AUTO_PURGE=false
RETENTION_DAYS=730
